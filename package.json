{
  "name": "threejs-personal-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspaces && node scripts/assemble.js",
    "preview": "node scripts/dev.js --preview",
    "storybook": "npm run storybook --workspace website-3d",
    "build-storybook": "npm run build-storybook --workspace website-3d",
    "gltfjsx": "npm run gltfjsx --workspace website-3d --"
  },
  "devDependencies": {
    "vite": "^5.3.3"
  }
}
